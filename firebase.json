{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "theturkeybowl",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      ".git",
      ".git/**",
      "**/.*",
      "**/.*/**",
      "Claude memory notes/**",
      "*.bak*",
      "**/node_modules/**",
      "tools/**",
      "*.log"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
