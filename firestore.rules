rules_version = '2';
// Turkey Bowl site: who can read and change what.
//   players/{slug}   nickname, comp, position/tier, and players added on the site. Anyone can read; approved editors can change.
//                    college {name, id}: editors set it like everything else on the player.
//   board/order      drag-and-drop order of the Draft Board. Anyone can read; approved editors can change.
//   draft/{season}   the live draft. Anyone can watch; editors run it; only the admin can reset it.
//   lottery/{season} draft lottery result. Anyone can read; editors run it before the draft starts.
//   teams/{season}   team names. Anyone can read; editors can rename.
//   trades/{id}      trade offers between captains (picks not made yet + drafted players). The proposing captain (or an
//                    editor) creates one; the other captain (or an editor) accepts/declines; the proposer can cancel.
//                    Accepting also writes draft/{season}.owners (pick -> team) and .moved (player -> team), checked below.
//   photos/{slug}    headshots uploaded on the site. Anyone can read; approved editors can change.
//   requests/{uid}   "Request edit access". The person themself creates it; only the admin can see the list.
//   editors/{uid}    people the admin approved. Only the admin can add or remove them.
// ADMIN_UIDS = the Google account(s) that run the site (Jack).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['Xh4m7OKapLMUAH3M124PC54KsE82']; }   // Jack
    function isEditor() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/editors/$(request.auth.uid)));
    }
    function shortText(v, max) { return v is string && v.size() <= max; }
    function validComp(c) {
      return c == null || (
        c is map && c.keys().hasOnly(['name', 'team', 'league', 'id', 'img'])
        && shortText(c.name, 60) && c.name.size() > 0
        && shortText(c.team, 60)
        && c.league in ['nfl', 'college-football']
        && c.id is string && c.id.matches('^[0-9]{1,12}$')
        && c.img is string && c.img.matches('^https://a[.]espncdn[.]com/.{1,200}$')
      );
    }

    // College tag: {name, id} where id is ESPN's college team id or "n-<NCAA.com slug>" (for the logo), or null for a typed-in school.
    function validCollege(c) {
      return c == null || (
        c is map && c.keys().hasOnly(['name', 'id'])
        && shortText(c.name, 40) && c.name.size() > 0
        && (!('id' in c) || c.id == null || (c.id is string && c.id.matches('^([0-9]{1,8}|n-[a-z0-9-]{1,60})$')))
      );
    }
    // Fields are optional because saves merge: a position change doesn't have to resend the nickname.
    function validPlayer(d) {
      return d.keys().hasOnly(['nickname', 'comp', 'tier', 'name', 'added', 'num', 'age', 'ht', 'wt', 'college', 'by', 'at'])
        && d.keys().hasAll(['by', 'at'])
        && (!('nickname' in d) || shortText(d.nickname, 30))
        && (!('comp' in d) || validComp(d.comp))
        && (!('tier' in d) || d.tier in ['QB', 'S', 'A', 'B', 'C', 'D', 'NA'])
        && (!('name' in d) || (d.name is string && d.name.matches("^[A-Za-z][A-Za-z.' -]{2,39}$")))
        && (!('added' in d) || d.added == true)
        && (!('num' in d) || d.num == null || (d.num is string && d.num.matches('^[0-9]{1,2}$')))
        && (!('age' in d) || d.age == null || (d.age is int && d.age >= 10 && d.age <= 99))
        && (!('ht' in d) || d.ht == null || (d.ht is string && d.ht.matches('^[4-7]-([0-9]|1[01])$')))
        && (!('wt' in d) || d.wt == null || (d.wt is int && d.wt >= 80 && d.wt <= 400))
        && (!('college' in d) || validCollege(d.college))
        && shortText(d.by, 60)
        && d.at == request.time;
    }

    match /players/{slug} {
      allow read: if true;
      allow create, update: if isEditor()
        && slug.matches('^[a-z0-9-]{1,60}$')
        && validPlayer(request.resource.data);
      allow delete: if isEditor();
    }

    // Drag-and-drop order of the Draft Board (one doc). Tiers live on players/{slug}.tier.
    match /board/{id} {
      allow read: if true;
      allow create, update: if isEditor() && id == 'order'
        && request.resource.data.keys().hasOnly(['order', 'by', 'at'])
        && request.resource.data.keys().hasAll(['order', 'by', 'at'])
        && request.resource.data.order is list
        && request.resource.data.order.size() <= 300
        && shortText(request.resource.data.by, 60)
        && request.resource.data.at == request.time;
    }

    // The live draft for a season. Editors start it and make picks (picks only ever grow by one, or shrink
    // by one for an undo). Once it's done only the admin can change it; only the admin can delete (reset) it.
    match /draft/{season} {
      allow read: if true;
      function validDraft(d) {
        return d.keys().hasOnly(['status', 'order', 'pool', 'picks', 'owners', 'moved', 'tradesDone', 'by', 'at'])
          && d.keys().hasAll(['status', 'order', 'pool', 'picks', 'by', 'at'])
          && d.status in ['live', 'done']
          && d.order is list && d.order.size() >= 2 && d.order.size() <= 20
          && d.pool is list && d.pool.size() <= 300
          && d.picks is list && d.picks.size() <= d.pool.size()
          && shortText(d.by, 60) && d.at == request.time;
      }
      allow create: if isEditor() && season.matches('^[0-9]{4}$')
        && validDraft(request.resource.data) && request.resource.data.picks.size() == 0;
      allow update: if isEditor() && validDraft(request.resource.data)
        && request.resource.data.order == resource.data.order
        && request.resource.data.pool == resource.data.pool
        && (resource.data.status == 'live' || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'status', 'moved', 'by', 'at'])
        && (request.resource.data.picks.size() == resource.data.picks.size() + 1
            || request.resource.data.picks.size() == resource.data.picks.size() - 1);
      // A captain account may make ONE pick: the next one, only when their team is on the clock
      // (snake order, unless that pick was traded: draft.owners["<pick index>"]).
      allow update: if signedIn() && validDraft(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['picks', 'status', 'by', 'at'])
        && resource.data.status == 'live'
        && request.resource.data.order == resource.data.order
        && request.resource.data.pool == resource.data.pool
        && request.resource.data.picks.size() == resource.data.picks.size() + 1
        && request.resource.data.picks[0:resource.data.picks.size()] == resource.data.picks
        && resource.data.pool.hasAny([request.resource.data.picks[resource.data.picks.size()]])
        && !resource.data.picks.hasAny([request.resource.data.picks[resource.data.picks.size()]])
        && request.resource.data.status == (request.resource.data.picks.size() >= resource.data.pool.size() ? 'done' : 'live')
        && get(/databases/$(database)/documents/captains/$(season)).data.byUid[request.auth.uid]
           == pickOwner(resource.data.get('owners', {}), resource.data.order, resource.data.picks.size());
      // Applying an accepted trade (same commit as trades/{id} going pending -> accepted).
      allow update: if signedIn() && tradeApplied(season);
      allow delete: if isAdmin();
    }

    // Who owns pick number i (0-based): a trade (owners map) or else the snake order.
    // These helpers take small pieces (owners, moved, order), never the whole draft doc: passing big values
    // around is what eats Firestore's 1000-expression budget for a rule.
    function pickOwner(o, order, i) {
      return o.get(string(i), order[onClock(order.size(), i)]);
    }
    // Who has a drafted player now: a trade (moved map) or else whoever made that pick.
    function playerOwner(o, m, order, name, i) {
      return m.get(name, pickOwner(o, order, i));
    }
    // The signed-in person's captain name for a season ('' if they aren't a captain).
    function capOf(season) {
      return exists(/databases/$(database)/documents/captains/$(season))
        ? get(/databases/$(database)/documents/captains/$(season)).data.byUid.get(request.auth.uid, '') : '';
    }
    // Applying an accepted trade, in the same commit as trades/{id} going pending -> accepted.
    function tradeApplied(season) {
      return request.resource.data.get('tradesDone', []).size() == resource.data.get('tradesDone', []).size() + 1
        && tradeCheck(season, resource.data, request.resource.data,
             request.resource.data.tradesDone[request.resource.data.tradesDone.size() - 1]);
    }
    function tradeCheck(season, d0, d1, tid) {
      return d1.diff(d0).affectedKeys().hasOnly(['owners', 'moved', 'tradesDone', 'by', 'at'])
        && d1.tradesDone.size() <= 300 && d1.tradesDone.hasAll(d0.get('tradesDone', [])) && !d0.get('tradesDone', []).hasAny([tid])
        && get(/databases/$(database)/documents/trades/$(tid)).data.status == 'pending'
        && shortText(d1.by, 60) && d1.at == request.time
        && tradeMoves(season, d0, d1.get('owners', {}), d1.get('moved', {}),
             getAfter(/databases/$(database)/documents/trades/$(tid)).data);
    }
    function tradeMoves(season, d0, o1, m1, t) {
      return t.status == 'accepted' && t.season == season
        && (isEditor() || capOf(season) == t.to)
        && o1.diff(d0.get('owners', {})).affectedKeys().hasOnly(t.givePicks.concat(t.getPicks))
        && m1.diff(d0.get('moved', {})).affectedKeys().hasOnly(t.givePlayers.concat(t.getPlayers))
        && tradeSides(d0.get('owners', {}), d0.get('moved', {}), d0.order, d0.picks, o1, m1, t);
    }
    function tradeSides(o0, m0, order, picks, o1, m1, t) {
      return picksOk(o0, o1, order, picks.size(), t.givePicks, t.from, t.to)
        && picksOk(o0, o1, order, picks.size(), t.getPicks, t.to, t.from)
        && playersOk({'o0': o0, 'm0': m0, 'order': order, 'picks': picks}, m1, t.givePlayers, t.givePlayerIdx, t.from, t.to)
        && playersOk({'o0': o0, 'm0': m0, 'order': order, 'picks': picks}, m1, t.getPlayers, t.getPlayerIdx, t.to, t.from);
    }
    // Each side has at most 3 items (validTrade), so these check items 0..2.
    // A traded pick: not made yet, belonged to `from` (trade or snake order), belongs to `to` after.
    // (A non-number k makes int() fail, which denies.)
    function pickItemOk(o0, o1, order, made, k, from, to) {
      return int(k) >= made && o0.get(k, order[onClock(order.size(), int(k))]) == from && o1.get(k, '') == to;
    }
    function picksOk(o0, o1, order, made, ks, from, to) {
      return (ks.size() < 1 || pickItemOk(o0, o1, order, made, ks[0], from, to))
        && (ks.size() < 2 || pickItemOk(o0, o1, order, made, ks[1], from, to))
        && (ks.size() < 3 || pickItemOk(o0, o1, order, made, ks[2], from, to));
    }
    // A traded player: really drafted at pick i, belonged to `from` (earlier trade, else whoever made pick i),
    // belongs to `to` after. c = {o0: owners before, m0: moved before, order, picks}. A bad index fails, which denies.
    function playerItemOk(c, m1, name, i, from, to) {
      return c.picks[i] == name && m1.get(name, '') == to
        && c.m0.get(name, c.o0.get(string(i), c.order[onClock(c.order.size(), i)])) == from;
    }
    function playersOk(c, m1, ns, ix, from, to) {
      return (ns.size() < 1 || playerItemOk(c, m1, ns[0], ix[0], from, to))
        && (ns.size() < 2 || playerItemOk(c, m1, ns[1], ix[1], from, to))
        && (ns.size() < 3 || playerItemOk(c, m1, ns[2], ix[2], from, to));
    }

    // Trade offers. {season, from, to (captain names), givePicks/getPicks: ["<pick index>"], givePlayers/getPlayers: [names],
    // givePlayerIdx/getPlayerIdx: [pick index each player was drafted at], note, status, by, at}. Up to 3 items (picks + players) a side:
    // that's what fits in Firestore's per-request rule budget (tested in the emulator at full size).
    match /trades/{id} {
      allow read: if true;
      function validTrade(t) {
        return t.keys().hasOnly(['season', 'from', 'to', 'givePicks', 'getPicks', 'givePlayers', 'getPlayers', 'givePlayerIdx', 'getPlayerIdx', 'note', 'status', 'by', 'at'])
          && t.keys().hasAll(['season', 'from', 'to', 'givePicks', 'getPicks', 'givePlayers', 'getPlayers', 'givePlayerIdx', 'getPlayerIdx', 'note', 'status', 'by', 'at'])
          && t.season is string && t.season.matches('^[0-9]{4}$')
          && shortText(t.from, 60) && shortText(t.to, 60) && t.from != t.to
          && t.givePicks is list && t.givePicks.size() <= 3 && t.getPicks is list && t.getPicks.size() <= 3
          && t.givePlayers is list && t.givePlayers.size() <= 3 && t.getPlayers is list && t.getPlayers.size() <= 3
          && t.givePlayerIdx is list && t.givePlayerIdx.size() == t.givePlayers.size()
          && t.getPlayerIdx is list && t.getPlayerIdx.size() == t.getPlayers.size()
          && t.givePicks.size() + t.givePlayers.size() <= 3 && t.getPicks.size() + t.getPlayers.size() <= 3
          && t.givePicks.size() + t.givePlayers.size() + t.getPicks.size() + t.getPlayers.size() > 0
          && shortText(t.note, 200) && shortText(t.by, 60) && t.at == request.time;
      }
      allow create: if signedIn() && validTrade(request.resource.data)
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/draft/$(request.resource.data.season))
        && get(/databases/$(database)/documents/draft/$(request.resource.data.season)).data.order.hasAll([request.resource.data.from, request.resource.data.to])
        && (isEditor() || capOf(request.resource.data.season) == request.resource.data.from);
      // The other captain (or an editor) accepts or declines; the proposer (or an editor) cancels.
      // Accepting must apply the trade to the draft in the same commit (draft tradesDone gains this id).
      allow update: if signedIn() && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'by', 'at'])
        && shortText(request.resource.data.by, 60) && request.resource.data.at == request.time
        && (
          (request.resource.data.status == 'declined' && (isEditor() || capOf(resource.data.season) == resource.data.to))
          || (request.resource.data.status == 'cancelled' && (isEditor() || capOf(resource.data.season) == resource.data.from))
          || (request.resource.data.status == 'accepted' && (isEditor() || capOf(resource.data.season) == resource.data.to)
              && getAfter(/databases/$(database)/documents/draft/$(resource.data.season)).data.get('tradesDone', []).hasAny([id])
              && !get(/databases/$(database)/documents/draft/$(resource.data.season)).data.get('tradesDone', []).hasAny([id]))
        );
      allow delete: if isAdmin();
    }

    // Which team is on the clock for pick number i (0-based) with n teams, snake order.
    function onClock(n, i) {
      return math.floor(i / n) % 2 == 0 ? i % n : n - 1 - (i % n);
    }

    // Captain accounts for a season: {byUid: {uid: captain name}, names: {uid: account name}}. Only Jack sets them.
    match /captains/{season} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['byUid', 'names', 'by', 'at'])
        && request.resource.data.byUid is map && request.resource.data.byUid.size() <= 20
        && request.resource.data.names is map && request.resource.data.names.size() <= 20;
    }

    // Team look (name, logo, color). The team's captain account or an editor can change it.
    match /teamInfo/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && id.matches('^[0-9]{4}-[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['season', 'cap', 'name', 'logo', 'color', 'by', 'at'])
        && request.resource.data.season is string && id.split('-')[0] == request.resource.data.season
        && shortText(request.resource.data.cap, 60)
        && shortText(request.resource.data.name, 30)
        && request.resource.data.logo is string
        && (request.resource.data.logo.size() <= 16 || (request.resource.data.logo.size() < 70000 && request.resource.data.logo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')))
        && request.resource.data.color is string && request.resource.data.color.matches('^(#[0-9a-fA-F]{6})?$')
        && shortText(request.resource.data.by, 60) && request.resource.data.at == request.time
        && (resource == null || resource.data.cap == request.resource.data.cap)
        && (isEditor() || get(/databases/$(database)/documents/captains/$(request.resource.data.season)).data.byUid[request.auth.uid] == request.resource.data.cap);
    }

    // Everyone who signs in leaves their name, so Jack can pick captain accounts. Only Jack can see the list.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
    }

    // Draft lottery result for a season. Editors can run it until the live draft starts.
    match /lottery/{season} {
      allow read: if true;
      allow create, update: if isEditor() && season.matches('^[0-9]{4}$')
        && !exists(/databases/$(database)/documents/draft/$(season))
        && request.resource.data.keys().hasOnly(['order', 'id', 'by', 'at'])
        && request.resource.data.keys().hasAll(['order', 'id', 'by', 'at'])
        && request.resource.data.order is list
        && request.resource.data.order.size() >= 2 && request.resource.data.order.size() <= 20
        && shortText(request.resource.data.id, 40)
        && shortText(request.resource.data.by, 60)
        && request.resource.data.at == request.time;
    }

    // Team names for a season, keyed by captain. Editors can rename teams at or after the draft.
    match /teams/{season} {
      allow read: if true;
      allow create, update: if isEditor() && season.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['names', 'by', 'at'])
        && request.resource.data.keys().hasAll(['names', 'by', 'at'])
        && request.resource.data.names is map
        && request.resource.data.names.size() <= 20
        && shortText(request.resource.data.by, 60)
        && request.resource.data.at == request.time;
    }

    // Headshots uploaded on the site: a small JPEG stored as a data: URL (the site shrinks it to 256px first).
    match /photos/{slug} {
      allow read: if true;
      allow create, update: if isEditor()
        && slug.matches('^[a-z0-9-]{1,60}$')
        && request.resource.data.keys().hasOnly(['img', 'by', 'at'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 200000
        && request.resource.data.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && shortText(request.resource.data.by, 60)
        && request.resource.data.at == request.time;
      allow delete: if isEditor();
    }

    match /requests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && shortText(request.resource.data.name, 80)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /editors/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && shortText(request.resource.data.name, 80)
        && shortText(request.resource.data.email, 120);
      allow delete: if isAdmin();
    }
  }
}
